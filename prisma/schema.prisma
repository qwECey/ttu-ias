generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  COMPANY
  SUPERVISOR
  INDUSTRY_SUPERVISOR
  LIAISON
  ADMIN
}

enum ReportType {
  WEEKLY
  MONTHLY
  FINAL
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlacementRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id       String   @id @default(cuid())
  loginId  String   @unique
  email    String?  @unique
  password String
  role     UserRole
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?
  company Company?

  supervisor Supervisor?

  industrySupervisor IndustrySupervisor?

  @@map("users")
}

model Student {
  id     String @id @default(cuid())
  userId String @unique

  studentId String  @unique
  fullName  String
  email     String? @unique
  phone     String?

  department String
  programme  String
  level      Int

  placementStatus String @default("UNPLACED")

  companyId String?

  user User @relation(fields: [userId], references: [id])

  company Company? @relation(fields: [companyId], references: [id])

  supervisorId String?

  supervisor Supervisor? @relation(fields: [supervisorId], references: [id])

  industrySupervisorId String?

  industrySupervisor IndustrySupervisor? @relation(fields: [industrySupervisorId], references: [id])

  placements Placement[]

  reports Report[]

  logbookWeeks LogbookWeek[]

  placementRequests PlacementRequest[]

  internships Internship[]

  @@map("students")
}

model Company {
  id     String @id @default(cuid())
  userId String @unique

  companyName String
  location    String

  contactPerson String
  contactPhone  String
  contactEmail  String?

  approved Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  students Student[]

  placements Placement[]

  internships Internship[]

  industrySupervisors IndustrySupervisor[]

  placementRequests PlacementRequest[]

  @@map("companies")
}

model IndustrySupervisor {
  id String @id @default(cuid())

  fullName String

  email String @unique

  phone String?

  companyId String

  company Company @relation(fields: [companyId], references: [id])

  userId String @unique

  user User @relation(fields: [userId], references: [id])

  students Student[]

  internships Internship[]

  @@map("industry_supervisors")
}

model Supervisor {
  id String @id @default(cuid())

  fullName String
  email    String  @unique
  phone    String?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  students Student[]

  internships Internship[]

  @@map("supervisors")
}

model Placement {
  id String @id @default(cuid())

  studentId String
  companyId String

  assignedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  company Company @relation(fields: [companyId], references: [id])

  @@map("placements")
}

model Report {
  id String @id @default(cuid())

  studentId String

  title String

  reportType ReportType

  periodNumber Int?

  content String

  fileUrl String?

  industryStatus ReportStatus @default(PENDING)

  academicStatus ReportStatus @default(PENDING)

  industryRemarks String?

  academicRemarks String?

  industryReviewedAt DateTime?

  academicReviewedAt DateTime?

  submittedAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@map("reports")
}

model PlacementRequest {
  id String @id @default(cuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  internshipId String?
  internship   Internship? @relation(fields: [internshipId], references: [id])

  // NEW
  companyId String?

  company Company? @relation(fields: [companyId], references: [id])

  companyName   String
  location      String
  contactPerson String
  contactPhone  String
  contactEmail  String?

  status PlacementRequestStatus @default(PENDING)

  liaisonRemarks String?

  createdAt DateTime @default(now())

  @@map("placement_requests")
}

model LogbookWeek {
  id String @id @default(cuid())

  // Old relationship (keep temporarily)
  studentId String

  // New relationship
  internshipId String?

  weekNumber Int

  department String?

  monday    String? @db.Text
  tuesday   String? @db.Text
  wednesday String? @db.Text
  thursday  String? @db.Text
  friday    String? @db.Text
  saturday  String? @db.Text
  sunday    String? @db.Text

  studentRemarks String? @db.Text

  submitted Boolean @default(false)

  certified Boolean @default(false)

  supervisorRemarks String? @db.Text

  certifiedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  internship Internship? @relation(fields: [internshipId], references: [id])

  @@unique([studentId, weekNumber])
  @@map("logbook_weeks")
}

model Internship {
  id String @id @default(cuid())

  studentId String

  companyId String?

  supervisorId String?

  industrySupervisorId String?

  academicYear String

  level Int

  semester Int

  startDate DateTime?

  endDate DateTime?

  durationWeeks Int

  placementStatus String @default("UNPLACED")

  status String @default("ACTIVE")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  company Company? @relation(fields: [companyId], references: [id])

  supervisor Supervisor? @relation(fields: [supervisorId], references: [id])

  industrySupervisor IndustrySupervisor? @relation(fields: [industrySupervisorId], references: [id])

  placementRequest PlacementRequest[]

  logbookWeeks LogbookWeek[]

  @@map("internships")
}
